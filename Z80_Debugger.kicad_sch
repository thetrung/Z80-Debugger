		(uuid "16093ca7-ebe7-409d-aac9-84e3b6099bcb")
	)
	(text "Note: If the Z80 executes OUT ($80), A, \naddress lines A2, A1, and A0 are all 0, \nmaking the 138 select output Y0. \nIf you wanted Port 0x81, \nyou would read from Y1 instead."
		(exclude_from_sim no)
		(at 40.894 188.722 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "16774c7f-bb2d-4d0d-a822-6631b81e098e")
	)
	(text "Forces SRAM to output data to the bus during a read cycle."
